# 环境变量模板
# 使用方法：复制此文件，重命名为对应环境文件，填入实际地址
#
#   本地开发  →  复制为 .env.development（npm run dev 时自动读取）
#   生产部署  →  复制为 .env.production（npm run build 时自动读取）
#   临时覆盖  →  复制为 .env（优先级最高，覆盖上面两个）
#
# 所有 .env* 文件均已加入 .gitignore，不会提交到 git

# API 服务器地址
VITE_API_BASE_URL=

# 是否启用 Mock 模式（true=使用模拟数据，false 或不填=调用真实后端）
# 开发环境建议 true，生产环境必须 false 或不填
VITE_USE_MOCK=

# ──────────────────────────────────────────
# 历史地址备忘（勿直接使用，填入对应 .env 文件）
# ──────────────────────────────────────────
# http://127.0.0.1:5000            本地开发服务器
# https://ameii.sysu.edu.cn/AMEII  生产环境（当前，带 base 路径，2026-）
# http://172.25.56.83:8080/api     生产环境（旧，2025-）
# http://172.25.56.83:5173/api     生产环境（旧）
# http://139.159.157.5:5000        云服务器（旧）
# http://110.41.177.107:8000       云服务器（最旧）
