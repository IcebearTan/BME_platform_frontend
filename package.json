{
  "name": "bme-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:user": "pnpm --filter @bme/user dev",
    "dev:admin": "pnpm --filter @bme/admin dev",
    "dev:all": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "build:user": "pnpm --filter @bme/user build",
    "build:admin": "pnpm --filter @bme/admin build",
    "preview:user": "pnpm --filter @bme/user preview",
    "preview:admin": "pnpm --filter @bme/admin preview",
    "release:user": "pnpm --filter @bme/user release"
  }
}
