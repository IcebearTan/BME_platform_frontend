{
  "name": "bme-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:user": "pnpm --filter @bme/user dev",
    "dev:admin": "pnpm --filter @bme/admin dev",
    "dev:all": "pnpm -r --parallel run dev",
    "dev:preview:api": "node scripts/preview/market-preview-server.mjs",
    "dev:preview:user": "pnpm --filter @bme/user dev:preview",
    "dev:preview:admin": "pnpm --filter @bme/admin dev:preview",
    "dev:preview": "node scripts/preview/start-preview.mjs",
    "build": "pnpm -r run build",
    "build:user": "pnpm --filter @bme/user build",
    "build:admin": "pnpm --filter @bme/admin build",
    "preview:user": "pnpm --filter @bme/user preview",
    "preview:admin": "pnpm --filter @bme/admin preview",
    "release:user": "pnpm --filter @bme/user release",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
